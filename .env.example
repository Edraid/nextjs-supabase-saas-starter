# ============================================================
# SUPABASE
# ============================================================
# Project URL — from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon key — safe to expose to client, enforced by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to client, bypasses RLS
# Only used in server-side route handlers and webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# STRIPE
# ============================================================
# From Stripe dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — from Stripe dashboard → Webhooks → your endpoint
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Your Stripe Price IDs (create in Stripe dashboard → Products)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# ============================================================
# RESEND (transactional emails)
# ============================================================
# From resend.com → API Keys
RESEND_API_KEY=re_...

# The "from" address — must be a verified domain in Resend
EMAIL_FROM=hello@yourdomain.com

# ============================================================
# APP
# ============================================================
# Your app's public URL (no trailing slash)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# SETUP NOTES
# ============================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values
# 3. For Stripe webhooks locally: npm install -g stripe && stripe login
#    Then: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 4. For email locally: use Resend's sandbox (no domain needed for @resend.dev)
